rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); }
    
    function isValidUser(data) {
      return data.keys().hasAll(['icr', 'isf', 'targetBg', 'lowBgLimit', 'highBgLimit', 'isConfigured', 'createdAt', 'updatedAt'])
        && data.icr is number
        && data.isf is number
        && data.targetBg is number
        && data.lowBgLimit is number
        && data.highBgLimit is number
        && data.isConfigured is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!('lastA1c' in data.keys()) || (data.lastA1c is number))
        && (!('name' in data.keys()) || (data.name is string && data.name.size() <= 100));
    }
    
    function isValidUserUpdate(data) {
      return data.icr is number
        && data.isf is number
        && data.targetBg is number
        && data.lowBgLimit is number
        && data.highBgLimit is number
        && data.isConfigured is bool
        && data.updatedAt == request.time
        && data.createdAt == existing().createdAt
        && (!('lastA1c' in data.keys()) || (data.lastA1c is number))
        && (!('name' in data.keys()) || (data.name is string && data.name.size() <= 100));
    }

    function isValidMealRecord(data) {
      return data.keys().hasAll(['timestamp', 'mealDescription', 'weightGrams', 'netCarbs', 'mealBolus', 'correctionBolus', 'totalDose', 'createdAt'])
        && data.timestamp is string && data.timestamp.size() <= 100
        && data.mealDescription is string && data.mealDescription.size() <= 5000
        && data.weightGrams is number
        && data.netCarbs is number
        && data.mealBolus is number
        && data.correctionBolus is number
        && data.totalDose is number
        && data.createdAt == request.time
        && (!('image' in data.keys()) || (data.image is string && data.image.size() <= 5000000))
        && (!('currentBg' in data.keys()) || (data.currentBg is number))
        && (!('isExerciseMode' in data.keys()) || (data.isExerciseMode is bool))
        && (!('isEstimatedWeight' in data.keys()) || (data.isEstimatedWeight is bool));
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['mealDescription', 'netCarbsPer100g', 'createdAt'])
        && data.mealDescription is string && data.mealDescription.size() <= 5000
        && data.netCarbsPer100g is number
        && data.createdAt == request.time
        && (!('image' in data.keys()) || (data.image is string && data.image.size() <= 5000000));
    }

    function isValidBasalLog(data) {
      return data.keys().hasAll(['timestamp', 'dose', 'createdAt'])
        && data.timestamp is string && data.timestamp.size() <= 100
        && data.dose is number
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) && incoming().keys().size() <= 10;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['icr', 'isf', 'targetBg', 'lowBgLimit', 'highBgLimit', 'name', 'lastA1c', 'isConfigured', 'updatedAt']);
      
      match /meals/{mealId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(mealId);
        allow list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(mealId) 
                      && isValidMealRecord(incoming()) && incoming().keys().size() <= 12
                      && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(mealId);
      }

      match /favorites/{favoriteId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(favoriteId);
        allow list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(favoriteId) 
                      && isValidFavorite(incoming()) && incoming().keys().size() <= 4
                      && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(favoriteId);
      }

      match /basalLogs/{logId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(logId);
        allow list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(logId) 
                      && isValidBasalLog(incoming()) && incoming().keys().size() <= 3
                      && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
